# Copy this file to server/.env and fill in real values.
# Never commit server/.env or any real credentials.
# Full walkthrough: ../README.md#getting-credentials-step-by-step

PORT=5000
NODE_ENV=development

# MongoDB connection string.
# In development the API can start without this and report the database as not configured.
# Atlas: Connect -> Drivers -> Node.js, replace <db_username> and <db_password>,
# and add a database name such as /nivora before the "?" query string.
# Percent-encode reserved characters in the password (for example @ as %40).
MONGODB_URI=mongodb://127.0.0.1:27017/nivora

# Exact frontend origin allowed by CORS. Use one origin, never "*".
# No path or trailing slash. Production example: https://your-store.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Authentication. JWT_SECRET must be at least 32 random characters.
# This is not an API key; generate it locally, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Leave this blank until you generate a value; blank or short values disable auth.
# Generate a value locally; never commit it or send it in chat.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cookie policy for the httpOnly auth cookie: lax, strict or none.
# Use none only with HTTPS and a cross-site frontend deployment.
COOKIE_SAME_SITE=lax

# Razorpay test-mode payments.
# Generate TEST keys from Dashboard -> Account & Settings -> API Keys.
# Leave blank until you have your own test account. Never commit real values.
# This phase accepts rzp_test_ keys only; live keys are rejected in code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set on the Razorpay Dashboard webhook endpoint.
# Subscribe to payment.captured, order.paid and payment.failed.
# Webhook URL: https://<api-host>/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
